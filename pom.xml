<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>xdviofdmx</groupId>
    <artifactId>xdviofdmx</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>xdviofdmx</name>
    <description>Convert XeTeX XDV output to OFD (GB/T 33190) natively - the OFD analogue of xdvipdfmx</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <ofdrw.version>2.5.1</ofdrw.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- XDV/SPX 解析（xdvjni，独立仓库；0.2.0 起 vendor tectonic_xdv 并
             转发 legacy fnt_def、char run 带坐标、可注入 TFM 宽度） -->
        <dependency>
            <groupId>com.github.xiedada05</groupId>
            <artifactId>xdvjni</artifactId>
            <version>0.2.0</version>
        </dependency>

        <!-- OFD 生成（GB/T 33190-2016），full 已聚合 core/font/layout/pkg/reader 等 -->
        <dependency>
            <groupId>org.ofdrw</groupId>
            <artifactId>ofdrw-full</artifactId>
            <version>${ofdrw.version}</version>
        </dependency>
        <!-- 低层页面组装（OFDGraphicsDocument / OFDPageGraphics2D.appendPageBlock） -->
        <dependency>
            <groupId>org.ofdrw</groupId>
            <artifactId>ofdrw-graphics2d</artifactId>
            <version>${ofdrw.version}</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <!-- 显式声明 central 置于 jitpack 之前：JitPack 对个别 Central 构件
             （如 xml-apis-ext:1.3.04）代理返回空 jar，顺序颠倒会导致编译失败 -->
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- 可执行 CLI fat jar：mvn package（无 profile，产物 target/xdviofdmx-<版本>-dist.jar）；
                 mvn package -Pdeb 另出剔除 Debian 系统库的 -deb.jar（见下方 deb profile） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <shadedArtifactAttached>true</shadedArtifactAttached>
                    <shadedClassifierName>dist</shadedClassifierName>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                                <exclude>module-info.class</exclude>
                                <exclude>META-INF/versions/*/module-info.class</exclude>
                            </excludes>
                        </filter>
                    </filters>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <mainClass>xdviofdmx.Main</mainClass>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                    </transformers>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Debian 打包：剔以下 13 个坐标（构建 .deb 时改用系统 /usr/share/java 库，
             见 scripts/build-deb.sh 与 README「Debian 打包」），其余（ofdrw 全家、
             pdfbox 3.x、fontbox、pdfbox-io、jbig2-imageio、ujmp、xdvjni）仍打进 jar。
             产物 target/xdviofdmx-<版本>-deb.jar（attached，classifier=deb）。 -->
        <profile>
            <id>deb</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.1</version>
                        <configuration>
                            <shadedClassifierName>deb</shadedClassifierName>
                            <filters>
                                <filter>
                                    <artifact>org.bouncycastle:*</artifact>
                                    <excludes><exclude>**</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>commons-io:commons-io</artifact>
                                    <excludes><exclude>**</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>org.apache.commons:commons-compress</artifact>
                                    <excludes><exclude>**</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>commons-logging:commons-logging</artifact>
                                    <excludes><exclude>**</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>org.slf4j:slf4j-api</artifact>
                                    <excludes><exclude>**</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>jaxen:jaxen</artifact>
                                    <excludes><exclude>**</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>org.dom4j:dom4j</artifact>
                                    <excludes><exclude>**</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>net.lingala.zip4j:zip4j</artifact>
                                    <excludes><exclude>**</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>org.apache.xmlgraphics:batik-all</artifact>
                                    <excludes><exclude>**</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>org.apache.xmlgraphics:xmlgraphics-commons</artifact>
                                    <excludes><exclude>**</exclude></excludes>
                                </filter>
                                <!-- imageio-tiff 连带 common-lang/io/image、imageio-core/metadata -->
                                <filter>
                                    <artifact>com.twelvemonkeys.imageio:*</artifact>
                                    <excludes><exclude>**</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>com.twelvemonkeys.common:*</artifact>
                                    <excludes><exclude>**</exclude></excludes>
                                </filter>
                                <!-- batik 传递依赖 xml-apis/xml-apis-ext，Debian 由
                                     libxml-commons-external-java 提供 -->
                                <filter>
                                    <artifact>xml-apis:*</artifact>
                                    <excludes><exclude>**</exclude></excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
